# ============================================
# CTF-AI Solver Pro - Plantilla de Configuración
# ============================================
# Copia este archivo como .env y completa tus claves de API personales:
# cp .env.example .env   (Linux / macOS)
# Copy-Item .env.example .env (PowerShell)

# --------------------------------------------
# Google Gemini API (Recomendado - Gratuito en Google AI Studio)
# Consigue tu clave gratis en: https://aistudio.google.com/app/apikey
# --------------------------------------------
GEMINI_API_KEY=tu_clave_gemini_aqui

# --------------------------------------------
# OpenAI API (Opcional - GPT-4o / GPT-4o-mini)
# Consigue tu clave en: https://platform.openai.com/api-keys
# --------------------------------------------
OPENAI_API_KEY=tu_clave_openai_aqui

# --------------------------------------------
# Anthropic Claude API (Opcional - Claude 3.5 Sonnet / Haiku)
# Consigue tu clave en: https://console.anthropic.com/
# --------------------------------------------
ANTHROPIC_API_KEY=tu_clave_claude_aqui

# --------------------------------------------
# Proveedor por defecto: gemini, openai, claude
# --------------------------------------------
DEFAULT_PROVIDER=gemini

# --------------------------------------------
# Modelo por defecto (dejar vacío para usar el predeterminado del proveedor)
# Ejemplos:
#   Gemini: gemini-3.8-flash, gemini-3.7-flash
#   OpenAI: gpt-4o, gpt-4o-mini
#   Claude: claude-3-5-sonnet-latest
# --------------------------------------------
DEFAULT_MODEL=
